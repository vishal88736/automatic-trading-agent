# Local paper services. Set both secret fields to independent random hex values.
KRONO_PAPER_DB_PASSWORD=
KRONO_PRODUCT_API_KEY=
KRONO_PAPER_INITIAL_USDT=10000
# Optional server-side key for the existing cryptocurrency.cv news provider.
NEWS_API_KEY=

# Encrypts linked exchange API keys (64 hex chars, e.g. `openssl rand -hex 32`). Optional;
# without it live trading stays disabled.
KRONO_CREDENTIAL_KEY=
