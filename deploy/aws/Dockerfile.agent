FROM ghcr.io/astral-sh/uv:0.13.0 AS uv
FROM python:3.12-slim-bookworm
COPY --from=uv /uv /uvx /bin/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_CACHE_DIR=/app/.runtime/uv-cache TERMINAL_MODE=SIMULATION RESEARCH_ENABLED=false
WORKDIR /app
RUN groupadd -g 10001 krono && useradd -u 10001 -g krono krono && mkdir -p /app/.runtime && chown 10001:10001 /app/.runtime
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-cache
COPY backend backend
COPY tradingagents tradingagents
COPY config config
ENV PATH=/app/.venv/bin:$PATH
VOLUME ["/app/.runtime"]
USER 10001
CMD ["python","-m","backend.cloud_worker"]
