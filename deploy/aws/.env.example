# Copy to deploy/aws/.env (ignored by Git). Prefer AWS SSO locally and task roles on ECS.
AWS_PROFILE=
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
KRONO_ENV=development
# Required by deployment preflight. Activate the Project cost-allocation tag in AWS Billing.
KRONO_MONTHLY_BUDGET_USD=
KRONO_BUDGET_EMAIL=
# Optional custom domain. CloudFront ACM certificate must be in us-east-1.
KRONO_DOMAIN_NAME=
KRONO_HOSTED_ZONE_ID=
KRONO_HOSTED_ZONE_NAME=
KRONO_CLOUDFRONT_CERTIFICATE_ARN=
# Filled after building/pushing versioned containers; include the sha256: prefix.
KRONO_API_IMAGE_DIGEST=
KRONO_AGENT_IMAGE_DIGEST=
KRONO_GITHUB_REPOSITORY=
# Reuse the account's existing GitHub OIDC provider for additional environments.
KRONO_GITHUB_OIDC_PROVIDER_ARN=
# Populate platform runtime values from CloudFormation outputs / ECS task environment.
KRONO_PUBLIC_ORIGIN=http://127.0.0.1:5173
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
KRONO_CONTROL_TABLE=
KRONO_AGENT_CONTROL_TABLE=
KRONO_RUNTIME_TABLE=
KRONO_ARTIFACT_BUCKET=
KRONO_CLUSTER_ARN=
KRONO_DEPLOYMENT_WORKFLOW_ARN=
KRONO_PROVISIONER_ROLE_ARN=
KRONO_TASK_EXECUTION_ROLE_ARN=
KRONO_AGENT_BOUNDARY_ARN=
KRONO_AGENT_IMAGE=
KRONO_PRIVATE_SUBNETS=
KRONO_AGENT_SECURITY_GROUP=
KRONO_RUNTIME_KMS_ARN=
KRONO_AGENT_LOG_GROUP=
KRONO_COORDINATION_QUEUE_URL=
KRONO_ANALYSIS_QUEUE_URL=
BEDROCK_MODEL_ID=minimax.minimax-m2.5
BEDROCK_MAX_OUTPUT_TOKENS=2048
BEDROCK_TEMPERATURE=0.2
BEDROCK_TIMEOUT_MS=120000
BEDROCK_MAX_ATTEMPTS=2
KRONO_MAX_AGENTS_PER_USER=3
KRONO_MAX_AGENT_SPECS_PER_USER=20
KRONO_DAILY_TOKEN_LIMIT=100000
KRONO_DAILY_RUNTIME_SECONDS=14400
KRONO_MESSAGE_RETENTION_DAYS=30
# Optional estimates only. Set both prices and the official source used; no invented prices.
# KRONO_BEDROCK_INPUT_USD_PER_MILLION=
# KRONO_BEDROCK_OUTPUT_USD_PER_MILLION=
# KRONO_PRICING_SOURCE=
