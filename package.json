{
  "name": "krono-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "check": "tsc --noEmit -p frontend/tsconfig.json",
    "dev:platform": "node --env-file-if-exists=deploy/aws/.env --import tsx backend/src/server.ts",
    "check:platform": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p infra/tsconfig.json",
    "build:platform": "tsc -p backend/tsconfig.json && esbuild backend/src/runtime/janitor.ts backend/src/runtime/broker.ts --bundle --platform=node --target=node22 --format=cjs --outdir=infra/dist --out-extension:.js=.cjs",
    "test:platform": "tsx --test backend/tests/platform/*.test.ts infra/test/*.test.ts",
    "aws:preflight": "node --env-file-if-exists=deploy/aws/.env --import tsx deploy/aws/manage.ts preflight",
    "aws:synth": "npm run build:platform && node --env-file-if-exists=deploy/aws/.env --import tsx deploy/aws/manage.ts synth",
    "aws:deploy": "node --env-file-if-exists=deploy/aws/.env --import tsx deploy/aws/manage.ts deploy",
    "test:e2e": "playwright test",
    "format": "prettier --write frontend/src frontend/index.html docs/*.md README.md"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1161.0",
    "@aws-sdk/client-cloudformation": "^3.1161.0",
    "@aws-sdk/client-cloudwatch": "^3.1161.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1161.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1161.0",
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-ecs": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@aws-sdk/client-sfn": "^3.1161.0",
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@aws-sdk/client-sts": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@fastify/cookie": "^11.1.5",
    "@fontsource-variable/inter": "^5.3.0",
    "aws-jwt-verify": "^5.2.1",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.7",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "aws-cdk": "^2.1147.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.0"
  }
}
