{
  "schema_version": 1,
  "providers": {
    "market": "coinbase",
    "news": "cryptocurrency.cv",
    "market_base_url": "https://api.exchange.coinbase.com",
    "news_base_url": "https://cryptocurrency.cv",
    "ticker_assets": ["BTC", "ETH", "SOL"],
    "spot_endpoints": {
      "binance_live": "https://api.binance.com",
      "binance_testnet": "https://testnet.binance.vision",
      "bybit_live": "https://api.bybit.com",
      "bybit_testnet": "https://api-testnet.bybit.com",
      "okx": "https://www.okx.com",
      "ticker_rest": "https://data-api.binance.vision/api/v3/ticker/24hr",
      "ticker_stream": "wss://data-stream.binance.vision/stream"
    },
    "timeout_seconds": 8,
    "connect_timeout_seconds": 4,
    "max_connections": 4,
    "concurrency": 3,
    "read_attempts": 2,
    "retry_delay_seconds": 0.2,
    "refresh": {
      "ticker_seconds": 5,
      "candles_seconds": 300,
      "news_seconds": 60,
      "failure_retry_seconds": 15
    },
    "assets": {
      "BTC": {
        "name": "Bitcoin",
        "product_id": "BTC-USD"
      },
      "ETH": {
        "name": "Ethereum",
        "product_id": "ETH-USD"
      },
      "SOL": {
        "name": "Solana",
        "product_id": "SOL-USD"
      }
    }
  },
  "simulation": {
    "initial_equity": "10000",
    "fee_bps": 10,
    "slippage_bps": 10,
    "liquidity_usd": "1000000",
    "network_fee_usd": "0",
    "quote_ttl_seconds": 20,
    "deadline_seconds": 30,
    "proposal_ttl_seconds": 120,
    "mark_snapshot_seconds": 60
  },
  "paper": {
    "fee_bps": 10,
    "slippage_bps": 10,
    "max_agents": 10,
    "max_trades_per_hour": 6,
    "max_trades_per_day": 20,
    "minimum_live_order_usdt": "5"
  },
  "scheduler": {
    "interval_seconds": 300,
    "default_asset": "BTC"
  }
}
