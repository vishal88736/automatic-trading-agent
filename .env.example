# Copy to .env (ignored by Git). `make dev` reads it; every value here is optional.
# Local secrets (database password, API signing key, session secret) are generated
# automatically into .runtime/dev.json on first run.

# --- Strategy chat model ---
# Without a key, the built-in rules drafter turns plain-English prompts into strategies.
# With a key, chat uses an LLM. GROQ_* works with any OpenAI-compatible endpoint:
#   Groq:       GROQ_BASE_URL=https://api.groq.com/openai/v1   GROQ_MODEL=openai/gpt-oss-120b
#   OpenAI:     GROQ_BASE_URL=https://api.openai.com/v1         GROQ_MODEL=gpt-4.1-mini
#   OpenRouter: GROQ_BASE_URL=https://openrouter.ai/api/v1      GROQ_MODEL=<provider/model>
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Force a provider: rules | groq | bedrock (bedrock uses the AWS credential chain).
KRONO_LLM_PROVIDER=

# --- Sign-in ---
# local (default for make dev): accounts in PostgreSQL. cognito: AWS Cognito (see docs/AWS_SETUP.md).
KRONO_AUTH_MODE=local

# --- Paper trading ---
# Opening virtual USDT credited to each new paper account.
KRONO_PAPER_INITIAL_USDT=10000
# Optional crypto news API key.
NEWS_API_KEY=

# --- Live trading ---
# Encrypts linked exchange API keys. `make dev` generates one in .runtime/dev.json; set it
# here only to share a key between machines. Losing it means users must re-link their keys.
KRONO_CREDENTIAL_KEY=
# Days of paper trading an agent needs before it can trade real funds (testnet: no wait).
KRONO_LIVE_PROMOTION_DAYS=7

# --- Database ---
# Leave empty to let `make dev` run PostgreSQL in Docker on 127.0.0.1:55432.
KRONO_DATABASE_DSN=

# --- Ports (defaults shown) ---
# TERMINAL_UI_PORT=5173
# KRONO_PORT=8790
# KRONO_PRODUCT_API_PORT=8794
# KRONO_DEV_DB_PORT=55432
