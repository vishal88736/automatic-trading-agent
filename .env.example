# Safe defaults. Simulation never signs or submits blockchain transactions.
TERMINAL_MODE=SIMULATION
KRONO_CONFIG_PATH=config/runtime.json
TERMINAL_DB=.runtime/terminal.sqlite3
TERMINAL_HOST=127.0.0.1
TERMINAL_PORT=8787
# AEGIS paper ledger; independent of the existing simulation ledger. Starts with entries paused.
AEGIS_ENABLED=true
AEGIS_DB=.runtime/aegis-paper.sqlite3
# Explicit make demo-testnet unlocks the separate local agent interactively.
# These settings alone never enable signing in make demo or through a browser.
AEGIS_TESTNET_DB=.runtime/aegis-testnet.sqlite3
AEGIS_TESTNET_AGENT_ACCOUNT=hsk-agent
AEGIS_TESTNET_SIGNER_JOURNAL=.runtime/aegis-testnet-signer.sqlite3
# Opt-in typed tool calling: none | anthropic | groq | openai | bedrock | auto.
# auto tries configured providers in that order. Fallback is allowed only BEFORE any tool runs.
AEGIS_LLM_PROVIDER=none
AEGIS_LLM_FALLBACKS=openai,bedrock
# Groq (OpenAI-compatible). Get a key at https://console.groq.com/keys, then set AEGIS_LLM_PROVIDER=groq.
GROQ_API_KEY=
AEGIS_GROQ_API_KEY=
AEGIS_GROQ_MODEL=llama-3.3-70b-versatile
AEGIS_GROQ_BASE_URL=https://api.groq.com/openai/v1
AEGIS_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
AEGIS_ANTHROPIC_MODEL=
AEGIS_OPENAI_API_KEY=
OPENAI_API_KEY=
AEGIS_OPENAI_BASE_URL=https://api.openai.com/v1
AEGIS_OPENAI_MODEL=
AEGIS_BEDROCK_MODEL=
AEGIS_BEDROCK_REGION=
# Bedrock uses the standard local AWS credential chain; never send these credentials to chat.
AWS_PROFILE=
AWS_REGION=
# Telegram is a separate opt-in adapter to this authenticated local paper API.
AEGIS_TELEGRAM_BOT_TOKEN=
AEGIS_TELEGRAM_CHAT_ID=
AEGIS_API_URL=http://127.0.0.1:8787
# Optional bearer token for API clients. Browser UI uses an HttpOnly local session.
TERMINAL_API_TOKEN=
# Live reference data with simulated execution. No wallet credentials are needed.
# Use fixture for both providers when intentionally running offline demo data.
# Saved Settings -> Data providers take precedence after the first startup.
MARKET_PROVIDER=coinbase
NEWS_PROVIDER=cryptocurrency.cv
NEWS_API_KEY=
# Optional bull/bear LLM research (langchain-openai is installed by make setup).
RESEARCH_ENABLED=false
# For Groq research: RESEARCH_ENABLED=true, LLM_PROVIDER=groq, RESEARCH_MODEL=llama-3.3-70b-versatile
# Use a different model than AEGIS_GROQ_MODEL: Groq's free tier limits tokens per minute per model,
# so separate models keep research from exhausting the chat budget. (uses GROQ_API_KEY; an empty key skips research instead of blocking).
LLM_PROVIDER=
RESEARCH_MODEL=
# Owner keys are never accepted. Default make demo uses paper execution.
# Explicit testnet startup uses the registered local agent keystore, never a browser key/password.
# Other signing/keeper CLIs require a registered deployment and a process-local hot key.
AEGIS_OWNER_ADDRESS=
AEGIS_AGENT_ADDRESS=
AEGIS_DEPLOYER_ACCOUNT=
AEGIS_DEPLOYER_KEYSTORE=
AEGIS_DEPLOYER_PASSWORD_FILE=
# AEGIS_AGENT_KEY is needed only in the explicit signed CLI, never by make demo.
AEGIS_AGENT_KEY=
AEGIS_AGENT_KEYSTORE=
AEGIS_AGENT_PASSWORD_FILE=
