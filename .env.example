# Safe defaults. Simulation never signs or submits blockchain transactions.
TERMINAL_MODE=SIMULATION
TERMINAL_DB=.runtime/terminal.sqlite3
TERMINAL_HOST=127.0.0.1
TERMINAL_PORT=8787
# Optional bearer token for API clients. Browser UI uses an HttpOnly local session.
TERMINAL_API_TOKEN=
# Demo fixtures stay visibly labelled. Switch to coinbase for read-only CEX data.
MARKET_PROVIDER=fixture
NEWS_PROVIDER=fixture
NEWS_API_KEY=
# Optional upstream LLM research. Install docs/upstream/requirements.txt separately.
RESEARCH_ENABLED=false
LLM_PROVIDER=
RESEARCH_MODEL=
# No private keys are accepted by this application.
# HSKSwap live execution is deliberately unavailable until integration validation.
