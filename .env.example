# Copy to .env (ignored by Git). Keep personal secrets in .env.local or the shell.
# Local secrets (database password, API signing key, session secret) are generated
# automatically into .runtime/dev.json on first run.

# --- Strategy chat model ---
# Without a key, the built-in rules drafter turns plain-English prompts into strategies.
# With a key, chat uses an LLM. GROQ_* works with any OpenAI-compatible endpoint:
#   Groq:       GROQ_BASE_URL=https://api.groq.com/openai/v1   GROQ_MODEL=openai/gpt-oss-120b
#   OpenAI:     GROQ_BASE_URL=https://api.openai.com/v1         GROQ_MODEL=gpt-5.4-mini
#   OpenRouter: GROQ_BASE_URL=https://openrouter.ai/api/v1      GROQ_MODEL=<provider/model>
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Force a provider: rules | groq | bedrock (bedrock uses the AWS credential chain).
KRONO_LLM_PROVIDER=

# --- Sign-in ---
# local (default for make dev): accounts in PostgreSQL. cognito: AWS Cognito (see docs/AWS_SETUP.md).
KRONO_AUTH_MODE=local
# Optional: OAuth web client ID (….apps.googleusercontent.com) to enable Google sign-in.
# Add the UI origin, e.g. http://127.0.0.1:5173, to its authorized JavaScript origins.
KRONO_GOOGLE_CLIENT_ID=

# --- Paper trading ---
# Opening virtual USDT credited to each new paper account.
KRONO_PAPER_INITIAL_USDT=10000
# Optional crypto news API key.
NEWS_API_KEY=
# Optional runtime configuration file relative to the project root or an absolute path.
# KRONO_CONFIG_PATH=config/runtime.json

# --- Live trading ---
# Encrypts linked exchange API keys. `make dev` generates one in .runtime/dev.json; set it
# here only to share a key between machines. Losing it means users must re-link their keys.
KRONO_CREDENTIAL_KEY=
# Days of paper trading an agent needs before it can trade real funds (testnet: no wait).
KRONO_LIVE_PROMOTION_DAYS=7

# --- Database ---
# Leave empty to let `make dev` run PostgreSQL in Docker on 127.0.0.1:55432.
KRONO_DATABASE_DSN=

# --- Ports (defaults shown, occupied defaults use a nearby free port) ---
# TERMINAL_UI_PORT=5173
# KRONO_PORT=8790
# KRONO_PRODUCT_API_PORT=8794
# KRONO_DEV_DB_PORT=55432

# --- Optional inherited research CLI (make setup installs the legacy extra) ---
TRADINGAGENTS_RESULTS_DIR=eval_results
TRADINGAGENTS_CACHE_DIR=.runtime/legacy-cache
TRADINGAGENTS_MEMORY_LOG_PATH=.runtime/legacy-memory/trading_memory.md
TRADINGAGENTS_DEEP_MODEL=
TRADINGAGENTS_QUICK_MODEL=
TRADINGAGENTS_BROKER_ACCOUNT_CONTEXT=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_USE_LOCAL=false
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_USE_PAPER=true
FINNHUB_API_KEY=
FRED_API_KEY=
COINDESK_API_KEY=
ALPHA_VANTAGE_API_KEY=
